				<text>App #</text>
			</staticText>
			<staticText>
				<reportElement x="75" y="5" width="120" uuid="12345678-1234-1234-1234-123456789016"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text>Business Name</text>
			</staticText>
			<staticText>
				<reportElement x="200" y="5" width="100" uuid="12345678-1234-1234-1234-123456789017"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text>Permit Type</text>
			</staticText>
			<staticText>
				<reportElement x="305" y="5" width="80" uuid="12345678-1234-1234-1234-123456789018"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text>Status</text>
			</staticText>
			<staticText>
				<reportElement x="390" y="5" width="75" uuid="12345678-1234-1234-1234-123456789019"/>
				<textElement textAlignment="Right">
					<font isBold="true"/>
				</textElement>
				<text>Amount</text>
			</staticText>
			<staticText>
				<reportElement x="470" y="5" width="75" uuid="12345678-1234-1234-1234-123456789020"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text>Date</text>
			</staticText>
		</band>
	</columnHeader>
	
	<!-- Detail Band -->
	<detail>
		<band height="20" splitType="Stretch">
			<textField>
				<reportElement x="10" y="5" width="60" uuid="12345678-1234-1234-1234-123456789021"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{application_number}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="75" y="5" width="120" uuid="12345678-1234-1234-1234-123456789022"/>
