		</band>
	</detail>
	
	<!-- Summary Band -->
	<summary>
		<band height="50" splitType="Stretch">
			<rectangle>
				<reportElement x="0" y="0" width="555" height="50" backcolor="#F0F0F0" uuid="12345678-1234-1234-1234-123456789027"/>
			</rectangle>
			<staticText>
				<reportElement x="20" y="5" width="100" uuid="12345678-1234-1234-1234-123456789028"/>
