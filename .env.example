# PAMS Docker Environment Configuration
# Copy this file to .env and update the values

# =====================
# Database Configuration
# =====================
MYSQL_ROOT_PASSWORD=your_secure_root_password
DB_NAME=pams_db
DB_USER=pams_user
DB_PASSWORD=your_secure_db_password

# =====================
# Backend Configuration
# =====================
# JWT Secret - Use a long random string (32+ characters). Required in production.
JWT_SECRET=your_super_secret_jwt_key_change_in_production_at_least_32_chars
JWT_EXPIRES_IN=24h
NODE_ENV=production
LOG_LEVEL=info

# Frontend URL for CORS configuration
FRONTEND_URL=http://192.168.11.17:6070

# =====================
# ETRACS Integration (optional — required only if using ETRACS features)
# =====================
ETRACS_BASE_URL=http://192.168.11.17:9050/api
ETRACS_API_KEY=replace_with_real_etracs_api_key

# =====================
# Frontend Configuration
# =====================
# API URL that the frontend will use to connect to the backend
# For local development: http://localhost:5040
# For production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://192.168.11.17:5040

# =====================
# Phase 4 options
# =====================
# Persist async jobs in MySQL (survives API restarts). Redis/BullMQ can replace later.
JOB_QUEUE_DURABLE=false
# Return OTP in API responses for local testing
PORTAL_OTP_DEBUG=true
# SMS stub vs live (integration hub)
SMS_ENABLED=false
